/dts-v1/;

/ {
    compatible = "innbox,g93", "econet,en7523";
    model = "Innbox G93";
    #address-cells = <1>;
    #size-cells = <1>;

    chosen {
        bootargs = "console=ttyS0,115200n8 earlycon root=/dev/ram0";
        stdout-path = "serial0:115200n8";
    };

    memory@80000000 {
        device_type = "memory";
        reg = <0x80000000 0x20000000>;
    };

    reserved-memory {
        #address-cells = <1>;
        #size-cells = <1>;
        ranges;

        atf_reserved: atf@80000000 {
            reg = <0x80000000 0x4000000>;
            no-map;
        };

        npu_binary: npu@84000000 {
            reg = <0x84000000 0x1000000>;
            no-map;
        };
    };

    cpus {
        #address-cells = <1>;
        #size-cells = <0>;

        cpu@0 {
            device_type = "cpu";
            compatible = "arm,cortex-a53";
            reg = <0x0>;
            enable-method = "psci";
        };

        cpu@1 {
            device_type = "cpu";
            compatible = "arm,cortex-a53";
            reg = <0x1>;
            enable-method = "psci";
        };
    };

    psci {
        compatible = "arm,psci-0.2";
        method = "smc";
    };

    timer {
        compatible = "arm,armv8-timer";
        interrupts = <1 13 4>, <1 14 4>, <1 11 4>, <1 10 4>;
    };

    interrupt-controller@9000000 {
        compatible = "arm,gic-v3";
        reg = <0x9000000 0x10000>;
        interrupt-controller;
        #interrupt-cells = <3>;
    };

    soc {
        compatible = "simple-bus";
        #address-cells = <1>;
        #size-cells = <1>;
        ranges;

        serial@1fbf0000 {
            compatible = "ns16550";
            reg = <0x1fbf0000 0x100>;
            interrupts = <0 0 4>;
            clock-frequency = <25000000>;
            status = "okay";
        };

        gpio@1fbf0200 {
            compatible = "econet,ecnt-gpio";
            reg = <0x1fbf0200 0x100>;
            gpio-controller;
            #gpio-cells = <2>;
        };

        spi@1fa10000 {
            compatible = "econet,ecnt-spi_ctrl";
            reg = <0x1fa10000 0x1000>;
            #address-cells = <1>;
            #size-cells = <0>;
            status = "okay";

            nand@0 {
                compatible = "spi-nand";
                reg = <0>;
                nand-ecc-mode = "hw";
                nand-on-flash-bbt;
            };
        };

        ethernet@1fb50000 {
            compatible = "econet,ecnt-frame_engine";
            reg = <0x1fb50000 0x10000>;
            interrupts = <0 9 4>;
            status = "okay";
        };

        pcie@1fa91000 {
            compatible = "econet,ecnt-pcie";
            reg = <0x1fa91000 0x1000>;
            interrupts = <0 4 4>;
            status = "okay";
        };
    };
};
